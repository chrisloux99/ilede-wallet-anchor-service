# iL3-Pay Environment Configuration
# Copy this to .env.local and fill in your values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/il3pay

# Stellar Network (Testnet by default)
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# iLede Coin Issuing Account
ISSUING_ACCOUNT_PUBLIC_KEY=
ISSUING_ACCOUNT_SECRET_KEY=

# Distribution Account
DISTRIBUTION_ACCOUNT_PUBLIC_KEY=
DISTRIBUTION_ACCOUNT_SECRET_KEY=

# Asset Configuration
ASSET_CODE=iLede

# SEP-10 Authentication
SIGNING_KEY_SECRET=

# JWT Secret (for auth tokens - generate a random 64-char string)
JWT_SECRET=

# Admin Token (required for /api/admin/mint - use constant-time comparison)
ADMIN_API_TOKEN=

# Domain Configuration
HOME_DOMAIN=il3pay.com

# CORS (comma-separated origins, empty = allow all)
CORS_ALLOWED_ORIGINS=

# Exchange Rates (configurable)
RATE_ILEDE_USDC=0.5
RATE_ILEDE_USD=0.5
QUOTE_FEE_PERCENT=0.001
QUOTE_TTL_MINUTES=5

# Feature Flags
NEXT_PUBLIC_KYC_ENABLED=true
NEXT_PUBLIC_QUOTES_ENABLED=true
NEXT_PUBLIC_DEPOSIT_ENABLED=true
NEXT_PUBLIC_WITHDRAW_ENABLED=true
